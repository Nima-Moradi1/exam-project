# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon PostgreSQL
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DATABASE_URL_TEST=

# Auth.js
AUTH_SECRET=
# Set to true in Vercel Preview and Production so Auth.js trusts the deployment host.
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Media storage
BLOB_READ_WRITE_TOKEN=

# Optional AI (set AI_PROVIDER to none, openai, google, or xai)
AI_PROVIDER=none
AI_MODEL=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=

# Seed-only values — do not use default passwords in production
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_DEMO_USERNAME=demo-user
SEED_DEMO_EMAIL=demo@example.com
SEED_DEMO_PASSWORD=

# Optional production rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
